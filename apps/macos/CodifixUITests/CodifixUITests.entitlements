<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The UI-test runner launches a local synthetic fixture process. Keep this
	     entitlement limited to the test runner; the shipping app stays sandboxed
	     according to its own target settings. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
