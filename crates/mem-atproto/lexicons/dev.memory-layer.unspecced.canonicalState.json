{
  "lexicon": 1,
  "id": "dev.memory-layer.unspecced.canonicalState",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["space", "canonicalId", "headVersionNo", "status"],
        "properties": {
          "space": { "type": "string", "maxLength": 256 },
          "canonicalId": { "type": "string", "format": "uuid" },
          "headVersionNo": { "type": "integer", "minimum": 0 },
          "status": { "type": "string", "maxLength": 64 },
          "archivedAt": { "type": "string", "format": "datetime" },
          "tombstonedAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
