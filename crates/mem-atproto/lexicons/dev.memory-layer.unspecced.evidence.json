{
  "lexicon": 1,
  "id": "dev.memory-layer.unspecced.evidence",
  "defs": {
    "main": {
      "type": "record",
      "key": "any",
      "record": {
        "type": "object",
        "required": [
          "schemaVersion",
          "recordId",
          "projectSpaceId",
          "author",
          "authoredAt",
          "evidenceId",
          "sourceId",
          "memoryId",
          "canonicalId",
          "versionNo",
          "sourceKind",
          "observedAt"
        ],
        "properties": {
          "schemaVersion": { "type": "integer", "minimum": 1 },
          "recordId": { "type": "string" },
          "projectSpaceId": { "type": "string" },
          "author": { "type": "string" },
          "authoredAt": { "type": "string", "format": "datetime" },
          "causationId": { "type": "string" },
          "evidenceId": { "type": "string" },
          "sourceId": { "type": "string" },
          "memoryId": { "type": "string" },
          "canonicalId": { "type": "string" },
          "versionNo": { "type": "integer", "minimum": 1 },
          "sourceKind": { "type": "string" },
          "taskId": { "type": "string" },
          "filePath": { "type": "string" },
          "gitCommit": { "type": "string" },
          "symbolName": { "type": "string" },
          "symbolKind": { "type": "string" },
          "excerpt": { "type": "string" },
          "provenance": {
            "type": "object",
            "required": ["status", "checkedAt"],
            "properties": {
              "status": { "type": "string" },
              "checkedAt": { "type": "string", "format": "datetime" },
              "reason": { "type": "string" },
              "resolvedPath": { "type": "string" }
            }
          },
          "observedAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
