{
  "lexicon": 1,
  "id": "dev.codifix.unspecced.canonicalState",
  "defs": {
    "main": {
      "type": "record",
      "key": "any",
      "record": {
        "type": "object",
        "required": [
          "schemaVersion",
          "recordId",
          "projectSpaceId",
          "author",
          "authoredAt",
          "canonicalId",
          "memoryId",
          "versionNo",
          "isTombstone",
          "status",
          "confidencePpm",
          "updatedAt"
        ],
        "properties": {
          "schemaVersion": { "type": "integer", "minimum": 1 },
          "recordId": { "type": "string" },
          "projectSpaceId": { "type": "string" },
          "author": { "type": "string" },
          "authoredAt": { "type": "string", "format": "datetime" },
          "causationId": { "type": "string" },
          "canonicalId": { "type": "string" },
          "memoryId": { "type": "string" },
          "versionNo": { "type": "integer", "minimum": 1 },
          "isTombstone": { "type": "boolean" },
          "status": { "type": "string" },
          "confidencePpm": { "type": "integer", "minimum": 0, "maximum": 1000000 },
          "updatedAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
