{
  "lexicon": 1,
  "id": "dev.memory-layer.unspecced.relation",
  "defs": {
    "main": {
      "type": "record",
      "key": "any",
      "record": {
        "type": "object",
        "required": [
          "schemaVersion",
          "recordId",
          "projectSpaceId",
          "author",
          "authoredAt",
          "srcCanonicalId",
          "relationType",
          "dstCanonicalId",
          "assertedAt"
        ],
        "properties": {
          "schemaVersion": { "type": "integer", "minimum": 1 },
          "recordId": { "type": "string" },
          "projectSpaceId": { "type": "string" },
          "author": { "type": "string" },
          "authoredAt": { "type": "string", "format": "datetime" },
          "causationId": { "type": "string" },
          "srcCanonicalId": { "type": "string" },
          "relationType": { "type": "string" },
          "dstCanonicalId": { "type": "string" },
          "assertedAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
