{
  "lexicon": 1,
  "id": "dev.memory-layer.unspecced.memoryVersion",
  "defs": {
    "main": {
      "type": "record",
      "key": "any",
      "record": {
        "type": "object",
        "required": [
          "schemaVersion",
          "recordId",
          "projectSpaceId",
          "author",
          "authoredAt",
          "memoryId",
          "canonicalId",
          "versionNo",
          "canonicalText",
          "summary",
          "memoryType",
          "importance",
          "confidencePpm",
          "status",
          "tags",
          "evidenceRefs",
          "relatedMemories",
          "createdAt",
          "updatedAt",
          "isTombstone"
        ],
        "properties": {
          "schemaVersion": { "type": "integer", "minimum": 1 },
          "recordId": { "type": "string" },
          "projectSpaceId": { "type": "string" },
          "author": { "type": "string" },
          "authoredAt": { "type": "string", "format": "datetime" },
          "causationId": { "type": "string" },
          "memoryId": { "type": "string" },
          "canonicalId": { "type": "string" },
          "versionNo": { "type": "integer", "minimum": 1 },
          "canonicalText": { "type": "string" },
          "summary": { "type": "string" },
          "memoryType": { "type": "string" },
          "importance": { "type": "integer" },
          "confidencePpm": { "type": "integer", "minimum": 0, "maximum": 1000000 },
          "status": { "type": "string" },
          "tags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "evidenceRefs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "relatedMemories": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["memoryId", "relationType", "summary", "memoryType", "confidencePpm"],
              "properties": {
                "memoryId": { "type": "string" },
                "relationType": { "type": "string" },
                "summary": { "type": "string" },
                "memoryType": { "type": "string" },
                "confidencePpm": { "type": "integer", "minimum": 0, "maximum": 1000000 }
              }
            }
          },
          "createdAt": { "type": "string", "format": "datetime" },
          "updatedAt": { "type": "string", "format": "datetime" },
          "isTombstone": { "type": "boolean" }
        }
      }
    }
  }
}
