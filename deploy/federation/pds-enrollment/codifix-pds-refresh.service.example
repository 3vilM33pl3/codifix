# Copy and replace these exact paths only after the policy review/authorize step.
# This is a host unit template, not permission to start a live maintainer.
[Unit]
Description=Codifix existing-account refresh-only PDS maintenance
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=codifix-pds-refresh
Group=codifix-pds-refresh
ExecStart=/usr/bin/node /opt/codifix/pds-enrollment/refresh-cli.mjs run /var/lib/codifix-pds-refresh/policy.json
Restart=on-abnormal
RestartSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/opt/codifix/pds-enrollment /var/lib/codifix-pds-refresh/policy.json /var/lib/codifix-pds-refresh/ca.pem
ReadWritePaths=/var/lib/codifix-pds-refresh/enrollment /var/lib/codifix-pds-access
# Only journal/session/DID state belongs in enrollment. Do not put bootstrap,
# account password or invitation files under either writable directory.
# The operator-only PDS hostname must resolve through the reviewed private network.
TimeoutStopSec=40

[Install]
WantedBy=multi-user.target
