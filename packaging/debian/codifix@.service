[Unit]
Description=Codifix instance %i
Documentation=file:/usr/share/doc/codifix/areas/README.md
After=network.target postgresql.service
# Configuration, executable and approval marker are staged by the operator.
# Installing a package neither creates these files nor enables this unit.
ConditionPathExists=/etc/codifix-instances/%i/activation-reviewed
ConditionPathExists=/opt/codifix/instances/%i/release/bin/codifix

[Service]
Type=simple
DynamicUser=true
User=codifix-area-%i
Group=codifix-area-%i
StateDirectory=codifix-instances/%i/service
StateDirectoryMode=0700
CacheDirectory=codifix-instances/%i/service
CacheDirectoryMode=0700
RuntimeDirectory=codifix-instances/%i/service
RuntimeDirectoryMode=0700
WorkingDirectory=/var/lib/codifix-instances/%i/service
LoadCredential=codifix.toml:/etc/codifix-instances/%i/codifix.toml
LoadCredential=codifix.sha256:/etc/codifix-instances/%i/codifix.sha256
# A finite environment is built by the launcher. Partial UnsetEnvironment lists
# cannot prevent arbitrary CODIFIX__ overrides or inherited federation.
ExecStartPre=/usr/bin/env -i PATH=/usr/bin:/bin /usr/libexec/codifix/verify-instance-release %i %d/codifix.sha256
ExecStart=/usr/libexec/codifix/run-instance %i %d
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RemoveIPC=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Initial staging permits local database and reverse-proxy traffic only.
# Reviewed gateway destinations require a separate explicit network policy.
IPAddressDeny=any
IPAddressAllow=localhost
# Source credentials are loaded by the service manager before this namespace.
# CA-specific deployments must additionally deny every locally inventoried
# signing/OpenBao storage path; this template is not a CA activation approval.
InaccessiblePaths=-/etc/codifix-instances -/var/lib/codifix-installations -/etc/codifix -/var/lib/codifix -/var/cache/codifix -/run/codifix -/etc/step-ca -/var/lib/step-ca -/etc/openbao -/var/lib/openbao -/etc/vault -/var/lib/vault -/run/docker.sock -/run/podman/podman.sock

[Install]
WantedBy=multi-user.target
