#!/usr/bin/env bash
set -euo pipefail

# An upgrade stages files only. Named instances use independently staged,
# pinned executables; neither they nor user/development services belong to this
# package hook. The legacy singleton alone depends on the removed /usr/bin file.
case "${1:-}" in
    remove|deconfigure)
        systemctl stop codifix-watch.service codifix.service || true
        ;;
esac
