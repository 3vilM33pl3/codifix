[Unit]
Description=Memory Layer instance %i
Documentation=file:/usr/share/doc/memory-layer/areas/README.md
After=network.target postgresql.service
# Configuration, executable and approval marker are staged by the operator.
# Installing a package neither creates these files nor enables this unit.
ConditionPathExists=/etc/memory-layer/instances/%i/activation-reviewed
ConditionPathExists=/opt/memory-layer/instances/%i/release/bin/memory

[Service]
Type=simple
DynamicUser=true
User=memory-area-%i
Group=memory-area-%i
StateDirectory=memory-layer/instances/%i/service
StateDirectoryMode=0700
CacheDirectory=memory-layer/instances/%i/service
CacheDirectoryMode=0700
RuntimeDirectory=memory-layer/instances/%i/service
RuntimeDirectoryMode=0700
WorkingDirectory=/var/lib/memory-layer/instances/%i/service
LoadCredential=memory-layer.toml:/etc/memory-layer/instances/%i/memory-layer.toml
LoadCredential=memory.sha256:/etc/memory-layer/instances/%i/memory.sha256
Environment=MEMORY_LAYER_PROFILE=prod
Environment=XDG_CONFIG_HOME=/var/lib/memory-layer/instances/%i/service/config
Environment=XDG_STATE_HOME=/var/lib/memory-layer/instances/%i/service/state
Environment=XDG_DATA_HOME=/var/lib/memory-layer/instances/%i/service/data
Environment=XDG_CACHE_HOME=/var/cache/memory-layer/instances/%i/service
UnsetEnvironment=OPENAI_API_KEY ANTHROPIC_API_KEY MEMORY_LAYER_DEV MEMORY_LAYER__DATABASE__URL MEMORY_LAYER__SERVICE__API_TOKEN
ExecStartPre=/usr/libexec/memory-layer/verify-instance-release %i %d/memory.sha256
ExecStart=/opt/memory-layer/instances/%i/release/bin/memory --config %d/memory-layer.toml service run
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RemoveIPC=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Initial staging permits local database and reverse-proxy traffic only.
# Reviewed gateway destinations require a separate explicit network policy.
IPAddressDeny=any
IPAddressAllow=localhost
# Source credentials are loaded by the service manager before this namespace.
# CA-specific deployments must additionally deny every locally inventoried
# signing/OpenBao storage path; this template is not a CA activation approval.
InaccessiblePaths=-/etc/memory-layer -/etc/step-ca -/var/lib/step-ca -/etc/openbao -/var/lib/openbao -/etc/vault -/var/lib/vault -/run/docker.sock -/run/podman/podman.sock

[Install]
WantedBy=multi-user.target
